# Databricks Live Voice Kit - Environment Configuration
# Copy to .env.local and fill in your values.

# LiveKit connection (required)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Databricks workspace (auto-detected inside Databricks Apps;
# set manually for local development)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your-databricks-token

# Databricks resources
GENIE_SPACE_ID=your-genie-space-id
DATABRICKS_WAREHOUSE_ID=your-warehouse-id

# Voice profile: premium | balanced | private | hybrid
VOICE_PROFILE=premium
